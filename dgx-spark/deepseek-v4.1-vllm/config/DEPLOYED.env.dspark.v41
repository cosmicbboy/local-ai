# DeepSeek-V4.1-Flash-1017 DSpark profile for 2x DGX Spark TP=2.
# Copy to .env.dspark on each node and adjust node-specific values.
#
# STATUS: DRAFT — NOT YET VALIDATED
# This file is adapted from the V4 config (config/DEPLOYED.env.dspark).
# Key differences from V4:
#   - Model: DeepSeek-V4.1-Flash-1017 (vs DeepSeek-V4-Flash-0731)
#   - Architecture: DeepseekV41ForCausalLM (vs DeepseekV4ForCausalLM)
#   - Tokenizer: deepseek_v41 (vs deepseek_v4)
#   - Built-in Jinja chat template (no encoding/ folder needed)
#   - Vision capable (image-text-to-text)
#
# BLOCKERS:
#   1. Image must support DeepseekV41ForCausalLM architecture
#   2. Image must have B12X/SM12x kernels for GB10 (sm_121a)
#   3. DSpark support for V4.1 is unconfirmed (may need MTP instead)

# Cluster
WORKER_HOST=192.168.100.11
WORKER_DIR=
WORKER_SCRIPT_DIR=
MASTER_ADDR=192.168.100.10
MASTER_PORT=25000
NODE_RANK=0
HEADLESS=
DSPARK_RESTART_POLICY=no

# Worker node should use:
# NODE_RANK=1
# HEADLESS=1

# RoCE / InfiniBand (head node)
NCCL_IB_HCA=rocep1s0f1
NCCL_SOCKET_IFNAME=enp1s0f1np1
TP_SOCKET_IFNAME=enp1s0f1np1
GLOO_SOCKET_IFNAME=enp1s0f1np1
NCCL_CROSS_NIC=1

# Caches / model
HF_CACHE=${HOME}/.cache/huggingface
WORKER_HF_CACHE=
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_XET=1

# Checkpoint — V4.1-Flash-1017 (Oct 2026 release)
# TODO: Pin to a specific revision after downloading
ABLITERATED=0
DSPARK_MODEL_OFFICIAL=deepseek-ai/DeepSeek-V4.1-Flash-1017
DSPARK_MODEL_ABLITERATED=
DSPARK_REVISION=main
SERVED_MODEL_NAME=deepseek-v4.1-flash-1017
VLLM_HOST=0.0.0.0
VLLM_PORT=8888

# Explicit per-node host IPs
VLLM_HOST_IP=192.168.100.10
WORKER_VLLM_HOST_IP=192.168.100.11

# Container image — TODO: Update to V4.1-capable image (blocker #2)
# Options:
#   - eugr/spark-vllm-b12x:latest (community Spark image)
#   - Custom build from vLLM ≥ 0.28.0 with SM12x support
DSPARK_VLLM_IMAGE=ghcr.io/anemll/dspark-vllm-gx10:0.1.1

# Serving profile
MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=6
MAX_NUM_BATCHED_TOKENS=8192
LONG_PREFILL_TOKEN_THRESHOLD=1024
DSPARK_MAX_INFLIGHT_PREFILLS=1
DSPARK_ISSUE43_SCHED_DIAG=0
VLLM_PREFIX_CACHE_RETENTION_INTERVAL=4096

# GPU memory utilization
GPU_MEMORY_UTILIZATION_TEXT=0.80
GPU_MEMORY_UTILIZATION_VISION=0.80

# Speculative decoding — TODO: Confirm DSpark support for V4.1 (blocker #3)
# If DSpark is not available, use MTP:
#   MTP_NUM_TOKENS=3
#   speculative-config '{"method":"mtp","num_speculative_tokens":3}'
MTP_NUM_TOKENS=5

# Default reasoning mode — V4.1 uses budget integers (1-100) or low/medium/high/max
DEFAULT_THINKING=high

# Vision mode flag
ENABLE_VL_SIDECAR=0
PREPARE_VL_SIDECAR_MODEL=0

# Anemll 0.1.1-safe vLLM / runtime knobs
VLLM_USE_FLASHINFER_SAMPLER=1
VLLM_USE_BREAKABLE_CUDAGRAPH=0
VLLM_USE_B12X_MOE=1
VLLM_B12X_W4A16_FORCE_BLOCKS_PER_SM=0
VLLM_B12X_W4A16_FORCE_BLOCKS_MAX_M=16
VLLM_B12X_W4A16_FORCE_TILE_CONFIG=

VLLM_ALLOW_LONG_MAX_MODEL_LEN=1
VLLM_SPARSE_INDEXER_MAX_LOGITS_MB=256
VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPH=0

# CuTeDSL / b12x compile target for GB10
CUTE_DSL_ARCH=sm_121a
TORCH_CUDA_ARCH_LIST=12.1a
FLASHINFER_CUDA_ARCH_LIST=12.1a
FLASHINFER_DISABLE_VERSION_CHECK=1
TILELANG_CLEANUP_TEMP_FILES=1
VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS=1800
TILELANG_CACHE_DIR=/cache/huggingface/tilelang-cache
TRITON_CACHE_DIR=/cache/huggingface/triton-cache

# NCCL / flight recorder
TORCH_FR_BUFFER_SIZE=2000
TORCH_NCCL_DUMP_ON_TIMEOUT=1
TORCH_NCCL_ENABLE_MONITORING=1
TORCH_FR_DUMP_TEMP_FILE=/cache/huggingface/nccl-fr/comm_lib_trace_rank_
TORCH_NCCL_DEBUG_INFO_PIPE_FILE=/tmp/fr_dump_pipe_
B12X_CUTE_COMPILE_CACHE_DIR=/cache/huggingface/b12x-cute-cache

DG_JIT_USE_NVRTC=0
DG_JIT_NVCC_COMPILER=/usr/local/cuda/bin/nvcc
NCCL_NET=IB
NCCL_IB_DISABLE=0
NCCL_CUMEM_ENABLE=0
NCCL_IGNORE_CPU_AFFINITY=1
NCCL_DEBUG=WARN
NCCL_NVLS_ENABLE=0

# Node-2 kernel-drift workaround (keep until kernel is fixed)
NCCL_MAX_NCHANNELS=8

PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
