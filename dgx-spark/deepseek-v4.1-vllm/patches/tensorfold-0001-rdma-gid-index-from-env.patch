+/// The served rings' GID index: TF_RDMA_GID_INDEX (0..255) when set, else 5. A link whose RoCE v2 IPv4 entry sits at
+/// another index (3 on a port with one IPv4 and one link-local address) sets it; NCCL_IB_GID_INDEX must match.
+pub fn envGidIndex() !u8 {
+    const raw = std.c.getenv("TF_RDMA_GID_INDEX") orelse return 5;
+    const v = std.mem.span(raw);
+    if (v.len == 0) return error.BadGidIndex;
+    for (v) |c| if (c < '0' or c > '9') return error.BadGidIndex;
+    return std.fmt.parseInt(u8, v, 10) catch error.BadGidIndex;
+}
